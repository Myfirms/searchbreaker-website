# Copy to .env for local use. .env is gitignored.

# Set to "true" in the deploy environment (Amplify) when the site is publicly
# ready. Anything else: every page renders noindex and robots.txt disallows all.
# PUBLIC_LAUNCHED=true

# Waitlist Lambda Function URL (see lambda/waitlist/). Unset = the form shows
# a truthful "not available yet" error instead of pretending to succeed.
# PUBLIC_WAITLIST_ENDPOINT_URL=

# Waitlist admin Lambda Function URL (see lambda/waitlist-admin/). Used by /internal/admin.
# PUBLIC_WAITLIST_ADMIN_URL=

# Content generation only (scripts/, run locally — never shipped to the browser).
# GEMINI_API_KEY=
