---
import Icon, { type IconKey } from '../primitives/Icon.astro';
import { inline } from '../../../lib/inline';

export interface CalloutProps {
  variant: 'tip' | 'warning' | 'note';
  /** ≤ 8 words. */
  title?: string;
  /** ≤ 40 words. */
  text: string;
}

const V: Record<string, [string, IconKey]> = {
  tip: ['Tip', 'check-circle'],
  warning: ['Warning', 'alert'],
  note: ['Note', 'info'],
};

const { variant, title, text } = Astro.props as CalloutProps;
const v = V[variant] ? variant : 'note';
const [kindLabel, icon] = V[v];
---

<aside class="sb-co" data-callout={v} aria-label={kindLabel}>
  <span class="sb-co__icon"><Icon icon={icon} size={20} /></span>
  <div class="sb-co__body">
    <span class="sb-co__kind">{kindLabel}</span>
    {title && <strong class="sb-co__title">{title}</strong>}
    <p class="sb-co__text" set:html={inline(text)} />
  </div>
</aside>

<style>
  .sb-co {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-sm);
    background: var(--co-bg);
    font-family: var(--font-sans);
    color: var(--color-text);
  }
  .sb-co__icon {
    display: flex;
    flex: none;
    color: var(--co-fg);
    padding-top: 2px;
  }
  .sb-co__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .sb-co__kind {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono-caps);
    text-transform: uppercase;
    font-weight: var(--font-weight-medium);
    color: var(--co-fg);
  }
  .sb-co__title {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    font-weight: var(--font-weight-semibold);
  }
  .sb-co__text {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
</style>
