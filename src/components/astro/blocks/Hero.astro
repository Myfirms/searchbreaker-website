---
import type { BadgeConfig, CtaConfig, LinkCta, SectionTone } from '../../../lib/types';
import AvailabilityBadge from '../primitives/AvailabilityBadge.astro';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import Section from '../foundation/Section.astro';
import ProductShot, { type ProductShotProps } from './ProductShot.astro';
import PipelineBoardFrame, { type PipelineColumn, type PipelineCard } from './PipelineBoardFrame.astro';
import BeforeAfterDiffFrame, { type DiffSegment, type Provenance } from './BeforeAfterDiffFrame.astro';
import RequirementEvidencePanelFrame, { type EvidenceRow } from './RequirementEvidencePanelFrame.astro';
import ComparisonTableFrame, { type ComparisonColumn, type ComparisonRow } from './ComparisonTableFrame.astro';
import JobFeedCard, { type Job } from './JobFeedCard.astro';
import { makeId } from '../../../lib/ids';

export interface HeroPipelineDemo {
  type: 'pipelineBoard';
  frameLabel?: string;
  columns: PipelineColumn[];
  cards: PipelineCard[];
  view?: 'kanban' | 'table';
}
export interface HeroBeforeAfterDemo {
  type: 'beforeAfterDiff';
  frameLabel?: string;
  requirement: string;
  before: DiffSegment[];
  after: DiffSegment[];
  provenance: Provenance;
  resumeVersion?: string;
}
export interface HeroRequirementEvidenceDemo {
  type: 'requirementEvidence';
  frameLabel?: string;
  rows: EvidenceRow[];
  footnote?: string;
}
export interface HeroComparisonDemo {
  type: 'comparisonTable';
  heading: string;
  columns: ComparisonColumn[];
  rows: ComparisonRow[];
  caption?: string;
}
export interface HeroJobFeedDemo {
  type: 'jobFeed';
  /** 1-2 cards — this is a hero, keep it compact. */
  jobs: Job[];
}
export type HeroDemo = HeroPipelineDemo | HeroBeforeAfterDemo | HeroRequirementEvidenceDemo | HeroComparisonDemo | HeroJobFeedDemo;

export interface HeroProps {
  /** home → --display-home, feature → --display-page. */
  variant: 'home' | 'feature';
  /** H1, ≤ 12 words. */
  headline: string;
  /** Answer-first, ≤ 40 words. */
  lead: string;
  primaryCta: CtaConfig;
  secondaryCta?: LinkCta;
  badge?: BadgeConfig;
  /** A real, live block used as the hero visual — prefer this over `media`. */
  demo?: HeroDemo;
  /** A static screenshot/illustration. Ignored when `demo` is set. */
  media?: ProductShotProps;
  reassurance?: string;
  tone?: SectionTone;
  /** Passed to WaitlistDialog as `source`, e.g. "home-hero". */
  waitlistSource?: string;
}

const { variant, headline, lead, primaryCta, secondaryCta, badge, demo, media, reassurance, tone = 'muted', waitlistSource } =
  Astro.props as HeroProps;
const id = makeId('sb-hero', headline);
---

<Section labelledby={id} tone={tone}>
  <div class="sb-hero">
    <div class="sb-hero__copy">
      {badge && <AvailabilityBadge state={badge.state} label={badge.label} detail={badge.detail} variant="outline" />}
      <h1 id={id} class:list={['sb-hero__h1', `sb-hero__h1--${variant}`]}>{headline}</h1>
      <p class="sb-hero__lead">{lead}</p>
      <div class="sb-hero__actions">
        <Button
          readiness={primaryCta.readiness}
          label={primaryCta.label}
          href={primaryCta.href}
          size="lg"
          waitlistSource={waitlistSource}
        />
        {secondaryCta && <Button variant="secondary" label={secondaryCta.label} href={secondaryCta.href} size="lg" />}
      </div>
      {reassurance && (
        <p class="sb-hero__reassurance"><Icon icon="lock" size={16} />{reassurance}</p>
      )}
    </div>
    {demo ? (
      <div class="sb-hero__demo">
        {demo.type === 'pipelineBoard' && (
          <PipelineBoardFrame frameLabel={demo.frameLabel} columns={demo.columns} cards={demo.cards} view={demo.view} />
        )}
        {demo.type === 'beforeAfterDiff' && (
          <BeforeAfterDiffFrame
            frameLabel={demo.frameLabel}
            requirement={demo.requirement}
            before={demo.before}
            after={demo.after}
            provenance={demo.provenance}
            resumeVersion={demo.resumeVersion}
          />
        )}
        {demo.type === 'requirementEvidence' && (
          <RequirementEvidencePanelFrame frameLabel={demo.frameLabel} rows={demo.rows} footnote={demo.footnote} />
        )}
        {demo.type === 'comparisonTable' && (
          <ComparisonTableFrame heading={demo.heading} columns={demo.columns} rows={demo.rows} caption={demo.caption} />
        )}
        {demo.type === 'jobFeed' && (
          <div class="sb-hero__jobfeed">
            {demo.jobs.map((job) => <JobFeedCard {job} />)}
          </div>
        )}
      </div>
    ) : (
      media && <ProductShot {...media} loading="eager" />
    )}
  </div>
</Section>

<style>
  .sb-hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 27.5rem), 1fr));
    gap: var(--space-12);
    align-items: center;
  }
  .sb-hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    max-width: 40rem;
  }
  .sb-hero__h1 {
    margin: 0;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    font-weight: var(--font-weight-semibold);
    text-wrap: balance;
  }
  .sb-hero__h1--home {
    font-size: var(--display-home);
  }
  .sb-hero__h1--feature {
    font-size: var(--display-page);
  }
  .sb-hero__lead {
    margin: 0;
    max-width: var(--measure-lead);
    font-size: var(--text-xl);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .sb-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    width: 100%;
  }
  .sb-hero__demo {
    width: 100%;
  }
  .sb-hero__jobfeed {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }
  .sb-hero__reassurance {
    margin: 0;
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  @media (max-width: 639.98px) {
    .sb-hero__actions {
      flex-direction: column;
    }
    .sb-hero__actions :global([data-variant]) {
      --btn-width: 100%;
    }
  }
</style>
