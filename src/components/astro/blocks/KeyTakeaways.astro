---
import Icon from '../primitives/Icon.astro';
import { makeId } from '../../../lib/ids';

export interface KeyTakeawaysProps {
  heading?: string;
  /** 3-5 items, ≤ 15 words each. */
  items: string[];
}

const { heading = 'Key takeaways', items } = Astro.props as KeyTakeawaysProps;
const id = makeId('sb-kt', heading);
---

<section class="sb-art sb-kt" aria-labelledby={id}>
  <div class="sb-art__inner">
    <div class="sb-kt__box" data-article-col="true">
      <h2 class="sb-kt__heading" id={id}>{heading}</h2>
      <ul class="sb-kt__list">
        {items.map((it) => (
          <li class="sb-kt__item"><span class="sb-kt__icon"><Icon icon="check" size={20} /></span>{it}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .sb-kt {
    padding: var(--space-6) var(--gutter);
  }
  .sb-kt__box {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }
  .sb-kt__heading {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    font-weight: var(--font-weight-semibold);
  }
  .sb-kt__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .sb-kt__item {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }
  .sb-kt__icon {
    display: flex;
    flex: none;
    color: var(--color-accent);
    padding-top: 3px;
  }
</style>
