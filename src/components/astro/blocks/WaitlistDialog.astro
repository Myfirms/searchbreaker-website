---
import AvailabilityBadge from '../primitives/AvailabilityBadge.astro';
import Icon from '../primitives/Icon.astro';
import WaitlistForm from './WaitlistForm.astro';

export interface WaitlistDialogProps {
  /** ≤ 8 words. */
  title?: string;
  /** ≤ 30 words. */
  text?: string;
  consentText?: string;
  showRole?: boolean;
}

const {
  title = 'Join the SearchBreaker waitlist',
  text = "SearchBreaker is in private testing. Leave your email and we'll invite you when the workflow you need is ready.",
  consentText,
  showRole = true,
} = Astro.props as WaitlistDialogProps;
---

<!-- Mount once per page (e.g. in PageLayout). Every [data-waitlist-open] trigger opens it and passes its source. -->
<dialog class="sb-wd-dialog" data-waitlist-dialog aria-labelledby="sb-wd-title" aria-describedby="sb-wd-desc">
  <div class="sb-wd-dialog__panel">
    <div class="sb-wd-dialog__head">
      <div class="sb-wd-dialog__titles">
        <AvailabilityBadge state="preview" detail="in private testing" />
        <h2 class="sb-wd-dialog__title" id="sb-wd-title">{title}</h2>
      </div>
      <button class="sb-wd-dialog__close" type="button" aria-label="Close" data-waitlist-close>
        <Icon icon="close" size={20} />
      </button>
    </div>
    <p class="sb-wd-dialog__text" id="sb-wd-desc">{text}</p>
    <WaitlistForm source="unknown" {consentText} {showRole} />
  </div>
</dialog>

<style>
  .sb-wd-dialog {
    width: 100%;
    max-width: 30rem;
    max-height: calc(100dvh - 2 * var(--space-6));
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    color: var(--color-text);
    box-shadow: var(--shadow-lg);
    font-family: var(--font-sans);
    overflow: auto;
  }
  .sb-wd-dialog::backdrop {
    background: var(--color-overlay);
  }
  .sb-wd-dialog__panel {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .sb-wd-dialog__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .sb-wd-dialog__titles {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
    align-items: flex-start;
  }
  .sb-wd-dialog__title {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    font-weight: var(--font-weight-semibold);
  }
  .sb-wd-dialog__close {
    width: var(--touch-target);
    height: var(--touch-target);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
  }
  .sb-wd-dialog__close:hover {
    background: var(--color-surface);
  }
  .sb-wd-dialog__text {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  /* Bottom sheet below 640px. */
  @media (max-width: 639.98px) {
    .sb-wd-dialog {
      max-width: none;
      margin: auto 0 0;
      max-height: 92dvh;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
  }
</style>

<script>
  import '../../../lib/waitlist-client';
</script>
