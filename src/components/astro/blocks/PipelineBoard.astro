---
import type { SectionTone } from '../../../lib/types';
import Section from '../foundation/Section.astro';
import SectionHeader from '../foundation/SectionHeader.astro';
import PipelineBoardFrame, { type PipelineColumn, type PipelineCard } from './PipelineBoardFrame.astro';
import { makeId } from '../../../lib/ids';

export type { PipelineColumn, PipelineCard };
export interface PipelineBoardProps {
  heading: string;
  lead?: string;
  frameLabel?: string;
  /** 5 columns max. */
  columns: PipelineColumn[];
  /** 4-8 fictional cards. */
  cards: PipelineCard[];
  /** Initial view. */
  view?: 'kanban' | 'table';
  tone?: SectionTone;
}

const { heading, lead, frameLabel, columns, cards, view, tone = 'default' } = Astro.props as PipelineBoardProps;
const id = makeId('sb-pb-section', heading);
---

<Section labelledby={id} tone={tone}>
  <div class="sb-pb-section">
    <SectionHeader {heading} {id} {lead} />
    <PipelineBoardFrame {frameLabel} {columns} {cards} {view} />
  </div>
</Section>

<style>
  .sb-pb-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
</style>
