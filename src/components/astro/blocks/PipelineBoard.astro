---
import type { SectionTone } from '../../../lib/types';
import AvailabilityBadge from '../primitives/AvailabilityBadge.astro';
import Icon from '../primitives/Icon.astro';
import Section from '../foundation/Section.astro';
import SectionHeader from '../foundation/SectionHeader.astro';
import { makeId } from '../../../lib/ids';

export interface PipelineColumn {
  id: string;
  title: string;
}
export interface PipelineCard {
  id: string | number;
  column: string;
  title: string;
  company: string;
  resumeVersion: string;
  nextAction: string;
  updated: string;
}
export interface PipelineBoardProps {
  heading: string;
  lead?: string;
  frameLabel?: string;
  /** 5 columns max. */
  columns: PipelineColumn[];
  /** 4-8 fictional cards. */
  cards: PipelineCard[];
  /** Initial view. */
  view?: 'kanban' | 'table';
  tone?: SectionTone;
}

const { heading, lead, frameLabel = 'Application pipeline', columns, cards, view = 'kanban', tone = 'default' } =
  Astro.props as PipelineBoardProps;
const id = makeId('sb-pb', heading);
const titleOf = Object.fromEntries(columns.map((c) => [c.id, c.title]));
---

<Section labelledby={id} tone={tone}>
  <div class="sb-pb" data-pipeline data-view={view}>
    <SectionHeader {heading} {id} {lead} />
    <div class="sb-pb__frame">
      <div class="sb-pb__bar">
        <div class="sb-pb__bar-left">
          <span class="sb-pb__label">{frameLabel}</span>
          <AvailabilityBadge state="illustrative" />
        </div>
        <div class="sb-pb__seg" role="group" aria-label="View">
          <button type="button" class="sb-pb__seg-btn" data-set-view="kanban" aria-pressed={view === 'kanban'}>
            <Icon icon="board" size={16} />Board
          </button>
          <button type="button" class="sb-pb__seg-btn" data-set-view="table" aria-pressed={view === 'table'}>
            <Icon icon="table" size={16} />Table
          </button>
        </div>
      </div>

      <div class="sb-pb__board" data-view-panel="kanban">
        {columns.map((col) => {
          const colCards = cards.filter((k) => k.column === col.id);
          return (
            <section class="sb-pb__col" aria-label={col.title}>
              <header class="sb-pb__col-head">
                <h3 class="sb-pb__col-title">{col.title}</h3>
                <span class="sb-pb__count">{colCards.length}</span>
              </header>
              {colCards.map((k) => (
                <article class="sb-pb__card">
                  <div class="sb-pb__card-top">
                    <span class="sb-pb__card-title">{k.title}</span>
                    <span class="sb-pb__card-company">{k.company}</span>
                  </div>
                  <span class="sb-pb__version"><Icon icon="file" size={16} />{k.resumeVersion}</span>
                  <span class="sb-pb__next">
                    <span class="sb-pb__next-icon"><Icon icon="arrow-right" size={16} /></span>{k.nextAction}
                  </span>
                </article>
              ))}
              {colCards.length === 0 && <p class="sb-pb__empty">No applications at this stage</p>}
            </section>
          );
        })}
      </div>

      <div class="sb-pb__table" role="table" aria-label={frameLabel} data-view-panel="table" hidden>
        <div class="sb-pb__row sb-pb__row--head" role="row">
          <span role="columnheader">Job</span>
          <span role="columnheader">Stage</span>
          <span role="columnheader">Resume</span>
          <span role="columnheader">Next action</span>
          <span role="columnheader">Updated</span>
        </div>
        {cards.map((k) => (
          <div class="sb-pb__row" role="row">
            <span class="sb-pb__cell-job" role="cell">
              <span class="sb-pb__card-title">{k.title}</span>
              <span class="sb-pb__card-company">{k.company}</span>
            </span>
            <span class="sb-pb__cell-stage" role="cell"><span class="sb-pb__stage">{titleOf[k.column] ?? k.column}</span></span>
            <span class="sb-pb__cell-resume" role="cell">{k.resumeVersion}</span>
            <span class="sb-pb__cell-next" role="cell">{k.nextAction}</span>
            <span class="sb-pb__cell-updated" role="cell">Updated {k.updated}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</Section>

<style>
  .sb-pb {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .sb-pb__frame {
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    overflow: hidden;
  }
  .sb-pb__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .sb-pb__bar-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .sb-pb__label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .sb-pb__seg {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
  }
  .sb-pb__seg-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 2.5rem;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }
  .sb-pb__seg-btn:hover {
    background: var(--color-surface);
  }
  .sb-pb__seg-btn[aria-pressed='true'] {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .sb-pb__board {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    padding: var(--space-4);
    scroll-snap-type: x mandatory;
  }
  .sb-pb__col {
    flex: 0 0 82%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    min-height: 16.25rem;
  }
  .sb-pb__col-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-1) var(--space-1);
  }
  .sb-pb__col-title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }
  .sb-pb__count {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }
  .sb-pb__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
  }
  .sb-pb__card-top,
  .sb-pb__cell-job {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sb-pb__card-title {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    font-weight: var(--font-weight-semibold);
  }
  .sb-pb__card-company {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
  .sb-pb__version {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }
  .sb-pb__next {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }
  .sb-pb__next-icon {
    display: flex;
    color: var(--color-accent);
  }
  .sb-pb__empty {
    margin: 0;
    padding: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-sm);
  }

  /* Table: stacked cards on mobile, five-column grid from 768px. */
  .sb-pb__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'job stage'
      'next next'
      'meta meta';
    gap: var(--space-2) var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .sb-pb__row--head {
    display: none;
  }
  .sb-pb__cell-job {
    grid-area: job;
  }
  .sb-pb__cell-stage {
    grid-area: stage;
  }
  .sb-pb__cell-next {
    grid-area: next;
  }
  .sb-pb__cell-resume,
  .sb-pb__cell-updated {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }
  .sb-pb__cell-resume {
    grid-area: meta;
  }
  .sb-pb__cell-updated {
    display: none;
  }
  .sb-pb__stage {
    display: inline-flex;
    align-items: center;
    height: 1.625rem;
    padding: 0 var(--space-2);
    border-radius: var(--radius-xs);
    background: var(--color-surface);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
  }

  /* View switching */
  .sb-pb[data-view='kanban'] [data-view-panel='table'],
  .sb-pb[data-view='table'] [data-view-panel='kanban'] {
    display: none;
  }

  @media (min-width: 768px) {
    .sb-pb__col {
      flex: 1 0 12.5rem;
    }
    .sb-pb__row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1.1fr) minmax(0, 0.9fr) minmax(0, 1.8fr) minmax(0, 0.8fr);
      grid-template-areas: 'job stage resume next updated';
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-3) var(--space-5);
    }
    .sb-pb__row--head {
      display: grid;
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-mono-caps);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .sb-pb__cell-resume {
      grid-area: resume;
      font-size: var(--text-xs);
    }
    .sb-pb__cell-updated {
      display: block;
      grid-area: updated;
      font-size: var(--text-xs);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pipeline]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-set-view]');
    const panels = root.querySelectorAll<HTMLElement>('[data-view-panel]');
    const show = (view: string) => {
      root.dataset.view = view;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setView === view)));
      panels.forEach((p) => (p.hidden = p.dataset.viewPanel !== view));
    };
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.setView!)));
    show(root.dataset.view ?? 'kanban');
  });
</script>
