---
import type { SectionTone } from '../../../lib/types';
import Section from '../foundation/Section.astro';
import SectionHeader from '../foundation/SectionHeader.astro';
import ComparisonTableFrame, { type ComparisonColumn, type ComparisonValue, type ComparisonRow } from './ComparisonTableFrame.astro';
import { makeId } from '../../../lib/ids';

export type { ComparisonColumn, ComparisonValue, ComparisonRow };
export interface ComparisonTableProps {
  heading: string;
  lead?: string;
  /** 2-4 columns. */
  columns: ComparisonColumn[];
  rows: ComparisonRow[];
  caption?: string;
  tone?: SectionTone;
}

const { heading, lead, columns, rows, caption, tone = 'default' } = Astro.props as ComparisonTableProps;
const id = makeId('sb-ct-section', heading);
---

<Section labelledby={id} tone={tone}>
  <div class="sb-ct-section">
    <SectionHeader {heading} {id} {lead} />
    <ComparisonTableFrame {heading} {columns} {rows} {caption} />
  </div>
</Section>

<style>
  .sb-ct-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
</style>
