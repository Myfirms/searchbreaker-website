---
import type { Availability, SectionTone } from '../../../lib/types';
import AvailabilityBadge from '../primitives/AvailabilityBadge.astro';
import Icon from '../primitives/Icon.astro';
import Section from '../foundation/Section.astro';
import SectionHeader from '../foundation/SectionHeader.astro';
import { makeId } from '../../../lib/ids';

export interface RelatedLink {
  label: string;
  /** Only published pages. */
  href: string;
  /** ≤ 15 words. */
  blurb?: string;
  kind?: 'next' | 'related' | 'guide';
  availability?: Availability;
}
export interface RelatedLinksProps {
  heading?: string;
  /** 2-4 links, the "next" workflow stage first. */
  items: RelatedLink[];
  tone?: SectionTone;
}

const KIND: Record<string, string> = { next: 'Next stage', related: 'Related', guide: 'Guide' };

const { heading = 'Where to go next', items, tone = 'default' } = Astro.props as RelatedLinksProps;
const id = makeId('sb-rl', heading);
---

<Section labelledby={id} tone={tone} tight>
  <div class="sb-rl">
    <SectionHeader {heading} {id} size="h3" />
    <ul class="sb-rl__grid">
      {items.map((it) => (
        <li class="sb-rl__cell">
          <a class="sb-rl__card" href={it.href}>
            <span class="sb-rl__meta">
              <span class="sb-rl__kind">{KIND[it.kind ?? 'related'] ?? 'Related'}</span>
              {it.availability && <AvailabilityBadge state={it.availability} />}
            </span>
            <span class="sb-rl__label">
              {it.label}
              <span class="sb-rl__arrow"><Icon icon="arrow-right" size={20} /></span>
            </span>
            {it.blurb && <span class="sb-rl__blurb">{it.blurb}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .sb-rl {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .sb-rl__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr));
    gap: var(--space-3);
  }
  .sb-rl__cell {
    display: flex;
  }
  .sb-rl__card {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }
  .sb-rl__card:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
  .sb-rl__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    min-height: 1.375rem;
  }
  .sb-rl__kind {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .sb-rl__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    font-weight: var(--font-weight-semibold);
  }
  .sb-rl__arrow {
    display: flex;
    color: var(--color-accent);
  }
  .sb-rl__blurb {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-secondary);
  }
</style>
