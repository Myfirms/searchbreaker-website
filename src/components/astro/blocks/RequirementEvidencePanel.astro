---
import type { SectionTone } from '../../../lib/types';
import Section from '../foundation/Section.astro';
import SectionHeader from '../foundation/SectionHeader.astro';
import RequirementEvidencePanelFrame, { type EvidenceRow } from './RequirementEvidencePanelFrame.astro';
import { makeId } from '../../../lib/ids';

export type { EvidenceRow };
export interface RequirementEvidencePanelProps {
  heading: string;
  lead?: string;
  frameLabel?: string;
  /** 3-7 rows. No numeric score. */
  rows: EvidenceRow[];
  footnote?: string;
  tone?: SectionTone;
}

const { heading, lead, frameLabel, rows, footnote, tone = 'default' } = Astro.props as RequirementEvidencePanelProps;
const id = makeId('sb-re-section', heading);
---

<Section labelledby={id} tone={tone}>
  <div class="sb-re-section">
    <SectionHeader {heading} {id} {lead} />
    <RequirementEvidencePanelFrame {frameLabel} {rows} {footnote} />
  </div>
</Section>

<style>
  .sb-re-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
</style>
