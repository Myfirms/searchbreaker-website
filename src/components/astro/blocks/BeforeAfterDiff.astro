---
import type { SectionTone } from '../../../lib/types';
import Section from '../foundation/Section.astro';
import SectionHeader from '../foundation/SectionHeader.astro';
import BeforeAfterDiffFrame, { type DiffSegment, type Provenance } from './BeforeAfterDiffFrame.astro';
import { makeId } from '../../../lib/ids';

export type { DiffSegment, Provenance };
export interface BeforeAfterDiffProps {
  heading: string;
  lead?: string;
  frameLabel?: string;
  /** Job requirement the edit responds to. */
  requirement: string;
  /** 'removed' segments render as <del>. ≤ 40 words per side. */
  before: DiffSegment[];
  /** 'added' segments render as <ins>. */
  after: DiffSegment[];
  /** Required: every edit cites a profile fact. */
  provenance: Provenance;
  resumeVersion?: string;
  tone?: SectionTone;
}

const { heading, lead, frameLabel, requirement, before, after, provenance, resumeVersion, tone = 'default' } =
  Astro.props as BeforeAfterDiffProps;
const id = makeId('sb-ba-section', heading);
---

<Section labelledby={id} tone={tone}>
  <div class="sb-ba-section">
    <SectionHeader {heading} {id} {lead} />
    <BeforeAfterDiffFrame {frameLabel} {requirement} {before} {after} {provenance} {resumeVersion} />
  </div>
</Section>

<style>
  .sb-ba-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
</style>
