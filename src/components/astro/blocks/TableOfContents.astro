---
import Icon from '../primitives/Icon.astro';

export interface TableOfContentsProps {
  /** Built from the h2 blocks; labels ≤ 6 words. */
  items: { id: string; label: string }[];
  title?: string;
  /** Sidebar is sticky ≥ 900px (the article container decides); collapsible <details> below. */
  variant: 'sidebar' | 'collapsible';
}

const { items, title = 'On this page', variant } = Astro.props as TableOfContentsProps;
---

{variant === 'sidebar' ? (
  <nav class="sb-toc sb-toc--sidebar" aria-label={title} data-toc-nav>
    <span class="sb-toc__title">{title}</span>
    <ol class="sb-toc__list">
      {items.map((it, i) => (
        <li>
          <a class="sb-toc__link" href={`#${it.id}`} data-toc-link={it.id} data-current={i === 0 ? 'true' : 'false'} aria-current={i === 0 ? 'location' : undefined}>
            {it.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
) : (
  <details class="sb-toc sb-toc--collapsible">
    <summary class="sb-toc__summary">
      {title}
      <span class="sb-toc__open"><Icon icon="chevron-down" size={16} /></span>
      <span class="sb-toc__close"><Icon icon="chevron-up" size={16} /></span>
    </summary>
    <nav aria-label={title}>
      <ol class="sb-toc__mlist">
        {items.map((it) => (
          <li><a class="sb-toc__mlink" href={`#${it.id}`}>{it.label}</a></li>
        ))}
      </ol>
    </nav>
  </details>
)}

<style>
  .sb-toc {
    font-family: var(--font-sans);
    color: var(--color-text);
  }
  .sb-toc--sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .sb-toc__title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .sb-toc__list,
  .sb-toc__mlist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sb-toc__list {
    display: flex;
    flex-direction: column;
  }
  .sb-toc__link {
    display: block;
    padding: 6px var(--space-3);
    border-left: 2px solid var(--nav-indicator);
    box-shadow: inset 1px 0 0 var(--color-border);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text);
    text-decoration: none;
  }
  .sb-toc__link:hover {
    color: var(--color-accent);
  }
  .sb-toc--collapsible {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
  }
  .sb-toc__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }
  .sb-toc__close {
    display: none;
  }
  .sb-toc--collapsible[open] .sb-toc__open {
    display: none;
  }
  .sb-toc--collapsible[open] .sb-toc__close {
    display: block;
  }
  .sb-toc__mlist {
    padding: 0 var(--space-4) var(--space-3);
  }
  .sb-toc__mlist li {
    border-top: 1px solid var(--color-border);
  }
  .sb-toc__mlink {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
  }
</style>

<script>
  // Marks the section currently in view (aria-current="location"). Anchor links work without JS.
  document.querySelectorAll<HTMLElement>('[data-toc-nav]').forEach((nav) => {
    if (!('IntersectionObserver' in window)) return;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const setActive = (id: string) =>
      links.forEach((l) => {
        const on = l.dataset.tocLink === id;
        l.dataset.current = String(on);
        if (on) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
      });
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    links.forEach((l) => {
      const target = document.getElementById(l.dataset.tocLink!);
      if (target) io.observe(target);
      l.addEventListener('click', () => setActive(l.dataset.tocLink!));
    });
  });
</script>
