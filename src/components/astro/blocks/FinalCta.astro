---
import type { CtaConfig, LinkCta, SectionTone } from '../../../lib/types';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import Section from '../foundation/Section.astro';
import { makeId } from '../../../lib/ids';

export interface FinalCtaProps {
  /** ≤ 10 words. */
  heading: string;
  /** ≤ 25 words. */
  text?: string;
  cta: CtaConfig;
  secondaryCta?: LinkCta;
  /** Must be true for the current product state. Pass '' to hide. */
  reassurance?: string;
  /** Default dark. */
  surface?: 'dark' | 'light';
  tone?: SectionTone;
  waitlistSource?: string;
}

const {
  heading,
  text,
  cta,
  secondaryCta,
  reassurance = 'You review everything before anything is sent.',
  surface = 'dark',
  tone = 'default',
  waitlistSource,
} = Astro.props as FinalCtaProps;
const id = makeId('sb-fcta', heading);
---

<Section labelledby={id} tone={tone} surface={surface}>
  <div class="sb-fcta">
    <div class="sb-fcta__copy">
      <h2 id={id} class="sb-fcta__heading">{heading}</h2>
      {text && <p class="sb-fcta__text">{text}</p>}
    </div>
    <div class="sb-fcta__actions">
      <div class="sb-fcta__buttons">
        <Button readiness={cta.readiness} label={cta.label} href={cta.href} size="lg" {waitlistSource} />
        {secondaryCta && <Button variant="secondary" label={secondaryCta.label} href={secondaryCta.href} size="lg" />}
      </div>
      {reassurance && <p class="sb-fcta__reassurance"><Icon icon="lock" size={16} />{reassurance}</p>}
    </div>
  </div>
</Section>

<style>
  .sb-fcta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8) var(--space-12);
  }
  .sb-fcta__copy {
    flex: 1 1 30rem;
    max-width: 45rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .sb-fcta__heading {
    margin: 0;
    font-size: var(--display-compact);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    font-weight: var(--font-weight-semibold);
    text-wrap: balance;
  }
  .sb-fcta__text {
    margin: 0;
    max-width: var(--measure-lead);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .sb-fcta__actions {
    flex: 0 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .sb-fcta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    width: 100%;
  }
  .sb-fcta__reassurance {
    margin: 0;
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  @media (max-width: 639.98px) {
    .sb-fcta__actions {
      width: 100%;
    }
    .sb-fcta__buttons {
      flex-direction: column;
    }
    .sb-fcta__buttons :global([data-variant]) {
      --btn-width: 100%;
    }
  }
</style>
