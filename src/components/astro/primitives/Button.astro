---
import type { Readiness } from '../../../lib/types';
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'link';
  /** `sm` is desktop-only. */
  size?: 'sm' | 'md' | 'lg';
  /** waitlist → "Join the waitlist" (opens WaitlistDialog); live → `label` ?? "Start profile". */
  readiness?: Readiness;
  label?: string;
  /** Renders <a>. Ignored for readiness="waitlist", which always renders a <button>. */
  href?: string;
  type?: 'button' | 'submit';
  loading?: boolean;
  loadingLabel?: string;
  disabled?: boolean;
  fullWidth?: boolean;
  /** Trailing arrow-right icon. */
  arrow?: boolean;
  ariaLabel?: string;
  /** Passed to WaitlistDialog as `source` when readiness="waitlist", e.g. "home-hero". */
  waitlistSource?: string;
  /** Rendered as data-action for block scripts (e.g. the BeforeAfterDiff review controls). */
  action?: string;
}

const {
  variant = 'primary',
  size = 'md',
  readiness,
  label,
  href,
  type = 'button',
  loading = false,
  loadingLabel,
  disabled = false,
  fullWidth = false,
  arrow = false,
  ariaLabel,
  waitlistSource,
  action,
} = Astro.props;

const base = readiness === 'live' ? (label ?? 'Start profile') : readiness === 'waitlist' ? 'Join the waitlist' : (label ?? 'Button');
const text = loading ? (loadingLabel ?? base) : base;
const blocked = disabled || loading;
const isWaitlist = readiness === 'waitlist';
const asLink = !!href && !blocked && !isWaitlist;
---

{asLink ? (
  <a class="sb-btn" href={href} data-variant={variant} data-size={size} data-full={fullWidth ? 'true' : 'false'} aria-label={ariaLabel} data-action={action}>
    {text}{arrow && <Icon icon="arrow-right" size={16} />}
  </a>
) : (
  <button
    class="sb-btn"
    type={type}
    data-variant={variant}
    data-size={size}
    data-full={fullWidth ? 'true' : 'false'}
    aria-disabled={disabled ? 'true' : undefined}
    aria-busy={loading ? 'true' : undefined}
    aria-label={ariaLabel}
    data-waitlist-open={isWaitlist && !blocked && type !== 'submit' ? '' : undefined}
    data-waitlist-source={isWaitlist ? waitlistSource : undefined}
    data-action={action}
  >
    {loading && (
      <svg class="sb-btn__spinner" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8" cy="8" r="6" opacity=".35" />
        <path d="M14 8a6 6 0 0 0-6-6" stroke-linecap="round" />
      </svg>
    )}
    {text}{arrow && <Icon icon="arrow-right" size={16} />}
  </button>
)}
