---
import type { Readiness } from '../../../lib/types';
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'link';
  /** `sm` is desktop-only. */
  size?: 'sm' | 'md' | 'lg';
  /** waitlist → "Join the waitlist" (opens WaitlistDialog); live → `label` ?? "Start profile". */
  readiness?: Readiness;
  label?: string;
  /** Renders <a>. Ignored for readiness="waitlist", which always renders a <button>. */
  href?: string;
  type?: 'button' | 'submit';
  loading?: boolean;
  loadingLabel?: string;
  disabled?: boolean;
  fullWidth?: boolean;
  /** Trailing arrow-right icon. */
  arrow?: boolean;
  ariaLabel?: string;
  /** Passed to WaitlistDialog as `source` when readiness="waitlist", e.g. "home-hero". */
  waitlistSource?: string;
}

const {
  variant = 'primary',
  size = 'md',
  readiness,
  label,
  href,
  type = 'button',
  loading = false,
  loadingLabel,
  disabled = false,
  fullWidth = false,
  arrow = false,
  ariaLabel,
  waitlistSource,
} = Astro.props;

const base = readiness === 'live' ? (label ?? 'Start profile') : readiness === 'waitlist' ? 'Join the waitlist' : (label ?? 'Button');
const text = loading ? (loadingLabel ?? base) : base;
const blocked = disabled || loading;
const isWaitlist = readiness === 'waitlist';
const asLink = !!href && !blocked && !isWaitlist;
---

{asLink ? (
  <a class="sb-btn" href={href} data-variant={variant} data-size={size} data-full={fullWidth ? 'true' : 'false'} aria-label={ariaLabel}>
    {text}{arrow && <Icon icon="arrow-right" size={16} />}
  </a>
) : (
  <button
    class="sb-btn"
    type={type}
    data-variant={variant}
    data-size={size}
    data-full={fullWidth ? 'true' : 'false'}
    aria-disabled={disabled ? 'true' : undefined}
    aria-busy={loading ? 'true' : undefined}
    aria-label={ariaLabel}
    data-waitlist-open={isWaitlist && !blocked ? '' : undefined}
    data-waitlist-source={isWaitlist ? waitlistSource : undefined}
  >
    {loading && (
      <svg class="sb-btn__spinner" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8" cy="8" r="6" opacity=".35" />
        <path d="M14 8a6 6 0 0 0-6-6" stroke-linecap="round" />
      </svg>
    )}
    {text}{arrow && <Icon icon="arrow-right" size={16} />}
  </button>
)}

<style>
  .sb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--btn-h);
    width: var(--btn-width);
    padding: 0 var(--btn-px);
    font-family: var(--button-font);
    font-size: var(--btn-fs);
    font-weight: var(--button-weight);
    line-height: 1;
    white-space: nowrap;
    border-radius: var(--button-radius);
    border: 1px solid var(--btn-border);
    background: var(--btn-bg);
    color: var(--btn-fg);
    text-decoration: var(--btn-decoration);
    text-underline-offset: var(--link-underline-offset);
    cursor: var(--btn-cursor);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }
  .sb-btn:hover {
    background: var(--btn-bg-hover);
    color: var(--btn-fg-hover);
    text-decoration-thickness: var(--link-underline-thickness-hover);
  }
  .sb-btn:active {
    background: var(--btn-bg-active);
  }
  .sb-btn__spinner {
    animation: sb-spin 0.9s linear infinite;
  }
  @keyframes sb-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sb-btn__spinner {
      animation: none;
    }
  }
</style>
