---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path such as "/", resolved against Astro.site. */
  canonicalPath?: string;
  /** Force noindex (e.g. /internal/*). Defaults to the inverse of PUBLIC_LAUNCHED. */
  noindex?: boolean;
}

/** Site-wide pre-launch gate. Anything but PUBLIC_LAUNCHED="true" renders
 * noindex,nofollow on every page and robots.txt disallows all. */
const SITE_LAUNCHED = import.meta.env.PUBLIC_LAUNCHED === 'true';

const { title, description, canonicalPath, noindex = !SITE_LAUNCHED } = Astro.props;
const canonicalHref = canonicalPath ? new URL(canonicalPath, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
